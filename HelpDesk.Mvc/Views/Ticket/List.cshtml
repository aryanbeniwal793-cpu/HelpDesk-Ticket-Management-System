@model IEnumerable<HelpDesk.Mvc.Models.Ticket>

<h2>All Tickets</h2>
<p>
    <a asp-action="Create" class="btn btn-primary">Raise New Ticket</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Raised By</th>
            <th>Created Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Id</td>
            <td>@item.Title</td>
            <td>@item.Priority</td>
            <td><span class="badge bg-info text-dark">@item.Status</span></td>
            <td>@item.RaisedBy</td>
            <td>@item.CreatedDate.ToString("yyyy-MM-dd")</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Details</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Delete this ticket?');">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
